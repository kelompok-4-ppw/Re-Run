{
  "info": {
    "_postman_id": "e593afcd-ed0d-461c-954f-e36ce2b3e78b",
    "name": "Re-Run API — Fase 0 (Contract & Middleware Smoke Test)",
    "description": "Pengujian kontrak JSON standar (status, message, data) dan middleware auth:sanctum + role:admin pada Fase 0.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "36993864"
  },
  "item": [
    {
      "name": "1. [200 OK] Smoke Test ApiResponse",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Struktur JSON sesuai kontrak ApiResponse\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.status).to.eql(true);",
              "    pm.expect(res).to.have.property('message');",
              "    pm.expect(res).to.have.property('data');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/home",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "home"
          ]
        }
      },
      "response": []
    },
    {
      "name": "2. [404 Not Found] Endpoint Tidak Terdaftar",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 404 Not Found\", function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "pm.test(\"Render JSON error (bukan HTML)\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.status).to.eql(false);",
              "    pm.expect(res.data).to.be.null;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/endpoint-ngasal",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "endpoint-ngasal"
          ]
        }
      },
      "response": []
    },
    {
      "name": "3. [401 Unauthorized] Akses Protected Tanpa Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "",
              "pm.test(\"Tidak redirect ke route login & struktur JSON valid\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.status).to.eql(false);",
              "    pm.expect(res.data).to.be.null;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/wishlist",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "wishlist"
          ]
        }
      },
      "response": []
    },
    {
      "name": "4. [403 Forbidden] Akses Admin Pakai Token Non-Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 403 Forbidden\", function () {",
              "    pm.response.to.have.status(403);",
              "});",
              "",
              "pm.test(\"Middleware role:admin memblokir user biasa\", function () {",
              "    const res = pm.response.json();",
              "    pm.expect(res.status).to.eql(false);",
              "    pm.expect(res.data).to.be.null;",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/admin/dashboard",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "admin",
            "dashboard"
          ]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": "PASTE_SANCTUM_TOKEN_DISINI"
    },
    {
      "key": "midtrans_server_key",
      "value": "PASTE_MIDTRANS_SERVER_KEY_SANDBOX_DISINI"
    }
  ]
}